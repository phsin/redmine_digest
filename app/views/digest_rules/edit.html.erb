<%= render 'includes' %>

<h2><%= l(:label_digest_rule_edit) %></h2>
<%= labelled_form_for(@digest_rule, url: digest_rule_path(@digest_rule, user_id: @user.id)) do |f| %>
    <%= render partial: 'form', locals: { f: f } %>
    <%= submit_tag l(:button_save) %>
    <%= link_to l(:button_cancel), (User.current.admin? && @user != User.current ? edit_user_path(@user) : { controller: 'my', action: 'account' }) %>
<% end %>
